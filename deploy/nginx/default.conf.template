# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# TLS is terminated by the outer proxy in deployed environments (docs/DEPLOYMENT.md, Phase 8).

# Original scheme from a trusted outer TLS proxy; requests that reach nginx directly keep $scheme.
map $http_x_forwarded_proto $oqtish_forwarded_proto {
    default $scheme;
    https   https;
}

upstream oqtish_api {
    server ${OQTISH_API_UPSTREAM};
}

server {
    listen ${OQTISH_WEB_LISTEN};

    # Real client IP (review R1). Only the host (an outer TLS proxy on this machine) and the compose
    # backend network are trusted to set X-Forwarded-For; real_ip_recursive skips those hops, so a
    # client-supplied header cannot spoof the address. The API then receives exactly one value and
    # per-IP rate limits apply per real client instead of platform-wide.
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ${OQTISH_TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    server_name _;
    server_tokens off;
    client_max_body_size 1m;

    include /etc/nginx/snippets/security-headers.conf;

    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass http://oqtish_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $oqtish_forwarded_proto;
        proxy_http_version 1.1;
    }

    location /health/ {
        proxy_pass http://oqtish_api;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Only served by the API in Development; returns 404 in Production.
    location ~ ^/(openapi|swagger)/ {
        proxy_pass http://oqtish_api;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Written at container start by 40-write-config-json.sh; the web root itself stays read-only.
    location = /config.json {
        alias /tmp/oqtish/config.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Telegram Mini App entry (BotFather Mini App URL = https://<host>/tg). Served from this
    # location (rewrite … break, no internal redirect) so the Telegram-specific headers apply.
    location = /tg {
        rewrite ^ /index.html break;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers-tg.conf;
    }

    location ^~ /tg/ {
        rewrite ^ /index.html break;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers-tg.conf;
    }

    # Telegram Login Widget redirect target: the signed payload is in the query string, so it is
    # kept out of the access log. The SPA removes it from the address bar immediately.
    location = /login/telegram {
        access_log off;
        rewrite ^ /index.html break;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
