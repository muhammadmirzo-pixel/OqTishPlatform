# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# TLS is terminated by the outer proxy in deployed environments (docs/DEPLOYMENT.md, Phase 8).

upstream oqtish_api {
    server ${OQTISH_API_UPSTREAM};
}

server {
    listen ${OQTISH_WEB_LISTEN};
    server_name _;
    server_tokens off;
    client_max_body_size 1m;

    include /etc/nginx/snippets/security-headers.conf;

    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass http://oqtish_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
    }

    location /health/ {
        proxy_pass http://oqtish_api;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Only served by the API in Development; returns 404 in Production.
    location ~ ^/(openapi|swagger)/ {
        proxy_pass http://oqtish_api;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Written at container start by 40-write-config-json.sh; the web root itself stays read-only.
    location = /config.json {
        alias /tmp/oqtish/config.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
