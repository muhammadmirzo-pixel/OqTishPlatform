<?xml version="1.0" encoding="utf-8"?>
<!-- Only nuget.org: machine-wide feeds (e.g. a company feed) would otherwise trigger NU1507 (warning as error)
     under central package management and make restores depend on the developer's machine. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
