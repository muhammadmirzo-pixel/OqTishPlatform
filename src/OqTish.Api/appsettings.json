{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "RateLimiting": {
    "GlobalPermitPerMinute": 300,
    "OtpSendPermitPerMinute": 10,
    "CredentialsPermitPerMinute": 20,
    "BookingPermitPerHour": 10
  },
  "Security": {
    "RequireTotpForPrivilegedRoles": true
  },
  "Auth": {
    "Otp": {
      "TtlSeconds": 300,
      "MaxAttempts": 5,
      "ResendCooldownSeconds": 60,
      "MaxPerPhone": 3,
      "MaxPerIp": 10,
      "WindowMinutes": 15
    },
    "Session": {
      "SlidingLifetimeDays": 30,
      "IdleTimeoutDays": 14,
      "TouchIntervalSeconds": 300,
      "RequireSecureCookie": true
    },
    "Password": {
      "MinLength": 10,
      "MaxFailedAttempts": 10,
      "LockoutMinutes": 15
    },
    "TelegramLinkTokenMinutes": 10
  },
  "Booking": {
    "PendingTtlMinutes": 30,
    "MinLeadMinutes": 60,
    "HorizonDays": 30,
    "SlotStepMinutes": 15,
    "PatientCancelCutoffMinutes": 120,
    "MaxPendingPerPatient": 3,
    "NoShowGraceMinutes": 15,
    "ReviewWindowDays": 30,
    "WalkInPastToleranceMinutes": 60,
    "SweeperIntervalSeconds": 30,
    "SweeperBatchSize": 100,
    "SearchDefaultAvailabilityDays": 7
  },
  "Telegram": {
    "Enabled": false,
    "BotUsername": "",
    "MiniAppUrl": "",
    "AuthMaxAgeSeconds": 86400,
    "Mode": "Polling",
    "WebhookBaseUrl": "",
    "RequestTimeoutSeconds": 15,
    "ChatRateLimitPerMinute": 20
  },
  "Notifications": {
    "PublicBaseUrl": ""
  },
  "Sms": {
    "Provider": "",
    "Eskiz": {
      "BaseUrl": "https://notify.eskiz.uz",
      "From": "4546",
      "TimeoutSeconds": 15
    }
  },
  "Finance": {
    "SummaryRunAtLocalTime": "02:00",
    "SummaryWindowDays": 35,
    "DailyReportMaxDays": 92
  }
}
