{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "Booking": {
    "SweeperIntervalSeconds": 30,
    "SweeperBatchSize": 100
  },
  "Telegram": {
    "Enabled": false,
    "BotUsername": "",
    "MiniAppUrl": "",
    "Mode": "Polling",
    "RequestTimeoutSeconds": 15,
    "PollingTimeoutSeconds": 25,
    "ChatRateLimitPerMinute": 20
  },
  "Notifications": {
    "DispatchIntervalSeconds": 2,
    "BatchSize": 20,
    "LeaseSeconds": 300,
    "MaxAttempts": 6,
    "BackoffSeconds": "60,300,1800,7200,21600",
    "JitterRatio": 0.2,
    "PublicBaseUrl": ""
  },
  "Retention": {
    "Enabled": true,
    "RunAtLocalTime": "03:30",
    "OtpChallengeHours": 24,
    "SessionDays": 30,
    "OutboxDays": 30,
    "FailedOutboxDays": 90,
    "LinkTokenHours": 24,
    "DevMessageDays": 7
  },
  "Finance": {
    "SummaryRunAtLocalTime": "02:00",
    "SummaryWindowDays": 35,
    "DailyReportMaxDays": 92
  }
}
