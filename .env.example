# Copy to .env and replace every placeholder. Never commit .env.
# Generate strong values, e.g.:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

POSTGRES_SUPERUSER_PASSWORD=__REPLACE_ME__
OQTISH_DB_OWNER_PASSWORD=__REPLACE_ME__
OQTISH_DB_API_PASSWORD=__REPLACE_ME__
OQTISH_DB_WORKER_PASSWORD=__REPLACE_ME__

# Production | Staging | Development
OQTISH_ENVIRONMENT=Production

# Host binding of the web entrypoint (keep 127.0.0.1 behind an outer TLS proxy).
OQTISH_HTTP_BIND=127.0.0.1
OQTISH_HTTP_PORT=8080

# Docker network for the backend; also the only network trusted for X-Forwarded-* headers.
OQTISH_BACKEND_SUBNET=172.30.240.0/24

# Public API base URL as seen by the browser (relative path when served behind the same proxy).
OQTISH_PUBLIC_API_BASE_URL=/api

# Dev overlay only: host port for PostgreSQL.
OQTISH_DB_PORT=55432

# Host PostgreSQL mode (compose.hostdb.yaml / dotnet run): connection to a PostgreSQL running on this
# machine. Used for migrations, API and Worker alike.
OQTISH_HOSTDB_CONNECTION="Host=localhost;Port=5432;Database=OqTish_db;Username=__REPLACE_ME__;Password=__REPLACE_ME__"

# Identity: server secret for OTP/identifier HMACs. Required outside Development (>= 32 random chars).
OQTISH_OTP_PEPPER=__REPLACE_ME_WITH_32+_RANDOM_CHARS__

# SMS (OD-09): Eskiz in Staging/Production; Fake is refused in Production. Empty = Fake in Development only.
OQTISH_SMS_PROVIDER=Eskiz
OQTISH_ESKIZ_EMAIL=__REPLACE_ME__
OQTISH_ESKIZ_PASSWORD=__REPLACE_ME__
OQTISH_ESKIZ_FROM=4546

# Telegram (Mini App / Login Widget / bot deep links). Keep false until a bot exists.
OQTISH_TELEGRAM_ENABLED=false
OQTISH_TELEGRAM_BOT_TOKEN=__REPLACE_ME__
OQTISH_TELEGRAM_BOT_USERNAME=
OQTISH_TELEGRAM_MINIAPP_URL=
# Real | Fake. Empty = Fake in Development (nothing is sent to Telegram), Real elsewhere. Fake is refused in Production.
OQTISH_TELEGRAM_CLIENT=
# Bot updates: Polling (default; the Worker long-polls, no public URL needed) or Webhook (Telegram calls the API).
OQTISH_TELEGRAM_MODE=Polling
# Webhook mode only: secret token (32-256 chars of A-Z a-z 0-9 _ -), e.g. openssl rand -hex 32
OQTISH_TELEGRAM_WEBHOOK_SECRET=__REPLACE_ME__
# Webhook mode only: public https base URL of this deployment, e.g. https://oqtish.example.uz
OQTISH_TELEGRAM_WEBHOOK_BASE_URL=

# Public https base URL of the web app ("open in console" buttons in staff Telegram messages). Empty = no button.
OQTISH_PUBLIC_BASE_URL=
