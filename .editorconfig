root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,tsx,js,css,html,md,props,csproj,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true:suggestion
# Async methods in libraries do not need a SynchronizationContext.
dotnet_diagnostic.CA2007.severity = none
# Logging: allow string interpolation-free structured templates only (CA2254 stays on).
dotnet_diagnostic.CA1848.severity = suggestion
# Public types in test projects / Program do not need to be sealed or documented.
dotnet_diagnostic.CA1515.severity = none

[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
